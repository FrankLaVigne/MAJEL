# Deployment config for the MAJEL Reachy adapter. Copy outside the repo, fill in, and point
# MAJEL_REACHY_CONFIG at it. Every value here is a placeholder. The console edits this file.

# Agent profile (private; see profile.example/). One profile per deployment.
PROFILE=~/.config/my-agent/profile.yaml
# systemd user unit that runs the bridge; also names the control socket.
SERVICE=majel-reachy
# Web console access token, created on first start.
PANEL_TOKEN=~/.config/my-agent/panel.token

REACHY_HOST=192.0.2.10

# Speech to text (OpenAI-compatible). Microphone audio goes here.
STT_URL=http://192.0.2.20:8000/v1
STT_MODEL=Systran/faster-whisper-base.en

# Model servers the console offers, as Name=URL pairs. Ollama or OpenAI-compatible.
MODEL_SERVERS=Ollama=http://192.0.2.20:11434/v1

# Conversation model.
LLM_URL=http://192.0.2.20:11434/v1
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Text to speech (OpenAI-compatible, raw 24 kHz PCM, e.g. Kokoro).
TTS_URL=http://192.0.2.20:8880/v1
TTS_MODEL=kokoro

# On-request vision. Frames go only here and are never stored. Leave blank to disable.
VISION_URL=http://192.0.2.20:11434/v1
VISION_MODEL=qwen2.5vl:7b
VISION_FALLBACK_URL=
VISION_FALLBACK_MODEL=

CAMERA=1
FACE_TRACKING_WEIGHT=0.8
LOG_OVERHEARD=0
