# Copy to ~/.config/systemd/user/<SERVICE>.service and adjust the paths.
[Unit]
Description=MAJEL Reachy adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=MAJEL_REACHY_CONFIG=%h/.config/my-agent/reachy.env
Environment=MAJEL_REACHY_PYTHON=%h/.local/share/majel-reachy/venv/bin/python
ExecStart=/opt/majel/adapters/reachy/run.sh
# SIGTERM becomes KeyboardInterrupt in bridge.py, which puts the robot to sleep.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
